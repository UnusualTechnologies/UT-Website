# design-docs project config. One key=value per line; # starts a comment.

# game | software
profile=software

# The branch that holds the shared truth (feature branches are compared against origin/<trunk>).
trunk=dev

# watch= marks code/assets that implement designed behaviour. Repeat the key, one glob per line.
# "*" (and "**") match across folders, e.g. src/* covers src/a/b/c.cs.
# A glob with no wildcard means that folder and everything in it (watch=src).
# With no watch= lines, everything except docs/, .claude/ and .git/ counts.
# watch=src/*
# watch=Assets/Scripts/*
# watch=app/*
watch=layouts/*
watch=content/*
watch=data/*
watch=static/css/*
watch=static/js/*
watch=static/admin/*
watch=archetypes/*
watch=hugo.toml
watch=apps-script/*
